@inherits LayoutComponentBase
@inject ResearchStateService State
@inject NavigationManager Nav
@implements IDisposable

<div class="app-layout">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="brand-badge">🦙</div>
            <div>
                <div class="sidebar-title">InspectaLlama</div>
                <div class="sidebar-subtitle">Edge Research Studio</div>
            </div>
        </div>

        <nav class="nav-menu">
            <NavLink class="nav-link-custom" href="" Match="NavLinkMatch.All">
                <span>1️⃣</span> Command Center
            </NavLink>
            <NavLink class="nav-link-custom" href="grill">
                <span>2️⃣</span> Grill-Me Interview
            </NavLink>
            <NavLink class="nav-link-custom" href="research">
                <span>3️⃣</span> Executive Report
            </NavLink>
            <NavLink class="nav-link-custom" href="telemetry">
                <span>4️⃣</span> Edge Telemetry
            </NavLink>
        </nav>
    </aside>

    <main class="main-content">
        <!-- Visual Flowing Pipeline Stepper Header -->
        <div class="glass-card" style="margin-bottom: 1.75rem; padding: 1rem 1.5rem; border-color: var(--border-indigo);">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; overflow-x: auto;">
                <div class="pipeline-step-item @(State.CurrentStageIndex == 1 ? "active" : (State.CurrentStageIndex > 1 ? "completed" : ""))" @onclick='() => Nav.NavigateTo("")'>
                    <span class="step-num">1</span>
                    <span class="step-name">Command Center</span>
                </div>
                <div class="step-connector"></div>
                <div class="pipeline-step-item @(State.CurrentStageIndex == 2 ? "active" : (State.CurrentStageIndex > 2 ? "completed" : ""))" @onclick='() => Nav.NavigateTo("grill")'>
                    <span class="step-num">2</span>
                    <span class="step-name">Grill-Me Interview</span>
                </div>
                <div class="step-connector"></div>
                <div class="pipeline-step-item @(State.CurrentStageIndex == 3 ? "active" : (State.CurrentStageIndex > 3 ? "completed" : ""))" @onclick='() => Nav.NavigateTo("research")'>
                    <span class="step-num">3</span>
                    <span class="step-name">Executive Report</span>
                </div>
                <div class="step-connector"></div>
                <div class="pipeline-step-item @(State.CurrentStageIndex == 4 ? "active" : "")" @onclick='() => Nav.NavigateTo("telemetry")'>
                    <span class="step-num">4</span>
                    <span class="step-name">Telemetry</span>
                </div>
            </div>
        </div>

        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnStateChanged -= StateHasChanged;
    }
}

