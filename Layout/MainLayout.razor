@inherits LayoutComponentBase
@inject HttpClient Http
@inject IJSRuntime JS

<div class="page flex flex-col min-h-screen bg-slate-950 text-slate-100 font-sans">
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <span class="text-2xl">🦙🔍</span>
            <span class="font-extrabold text-xl tracking-tight text-white">Inspecta<span class="text-indigo-400">Llama</span></span>
            <div class="do-power-badge" title="State persistence & real-time telemetry powered by Cloudflare Durable Objects">
                <span class="do-bolt">⚡</span>
                <span class="do-label">POWERED BY <strong class="do-highlight">CLOUDFLARE DURABLE OBJECTS</strong></span>
            </div>
        </div>
        <div class="flex items-center gap-4">
            @if (userSession != null && userSession.IsAuthenticated)
            {
                <div class="flex items-center gap-3 bg-slate-900 border border-slate-800 rounded-xl px-3 py-1.5 text-xs">
                    <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-indigo-500 to-cyan-400 text-white font-bold flex items-center justify-center text-xs">
                        @(string.IsNullOrEmpty(userSession.Name) ? "D" : userSession.Name.Substring(0, 1).ToUpper())
                    </div>
                    <div class="flex flex-col">
                        <span class="font-semibold text-slate-200">@userSession.Name</span>
                        <span class="text-[10px] text-slate-400">@userSession.Email</span>
                    </div>
                    
                    @if (isPro || userSession.SubscriptionTier.ToLower() == "pro" || userSession.SubscriptionTier.ToLower() == "enterprise")
                    {
                        <a href="https://personalization.dondlingergc.com/subscription" target="_blank"
                           class="text-[10px] px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold uppercase hover:bg-emerald-500/30 transition">
                            👑 Unlimited Pro
                        </a>
                    }
                    else
                    {
                        <a href="https://personalization.dondlingergc.com/credits" target="_blank"
                           class="text-[10px] px-2 py-0.5 rounded-md bg-slate-800 hover:bg-slate-700 text-indigo-300 border border-slate-700 font-mono transition">
                            💳 @userSession.CreditBalance Credits
                        </a>
                    }

                    <a href="https://personalization.dondlingergc.com/account" target="_blank" title="Manage Account & Settings"
                       class="ml-1 text-slate-400 hover:text-white transition">
                        ⚙️ Settings
                    </a>
                </div>
            }
            else
            {
                <a href="https://personalization.dondlingergc.com" target="_blank"
                   class="text-xs text-indigo-400 hover:text-indigo-300 font-semibold transition border border-indigo-500/30 rounded-lg px-3 py-1.5 bg-indigo-500/10">
                    🔑 Sign In (personalization.dondlingergc.com)
                </a>
            }

            @if (isPro)
            {
                <a href="https://personalization.dondlingergc.com/subscription" target="_blank"
                   class="text-xs px-3 py-1.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold flex items-center gap-1.5 hover:bg-emerald-500/30 transition">
                    <span>👑</span> Inspecta Pro (Active)
                </a>
            }
            else
            {
                <a href="https://personalization.dondlingergc.com/subscription" target="_blank"
                   class="text-xs bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-4 py-2 rounded-lg shadow-lg shadow-indigo-600/30 transition flex items-center gap-2">
                    <span>Upgrade Pro / Manage Credits →</span>
                </a>
            }
        </div>
    </header>

    <main class="flex-1 max-w-5xl w-full mx-auto p-6">
        @Body
    </main>

    <footer class="border-t border-slate-800 py-6 text-center text-xs text-slate-500 flex flex-col items-center gap-1">
        <div>InspectaLlama Engine &copy; 2026 &bull; Cloudflare Edge Durable Objects &amp; Browser Rendering</div>
        <div class="text-[11px] text-slate-600">Integrated with Central Dondlinger Identity Portal (personalization.dondlingergc.com)</div>
    </footer>
</div>

@code {
    private bool isPro = false;
    private bool isCheckoutLoading = false;
    private PersonalizationSession? userSession = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FetchUserSession();
            StateHasChanged();
        }
    }

    private async Task FetchUserSession()
    {
        try
        {
            var sessionJson = await JS.InvokeAsync<string>("zlaInterop.checkPersonalizationSession");
            if (!string.IsNullOrEmpty(sessionJson))
            {
                userSession = System.Text.Json.JsonSerializer.Deserialize<PersonalizationSession>(sessionJson, new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (userSession != null && (userSession.SubscriptionTier.ToLower() == "pro" || userSession.SubscriptionTier.ToLower() == "enterprise"))
                {
                    isPro = true;
                }
            }

            var res = await Http.GetFromJsonAsync<UserStatusResponse>("/api/user/status");
            if (res != null && res.IsPro)
            {
                isPro = true;
            }
        }
        catch (Exception)
        {
            // Fallback for offline ZLA execution
        }
    }

    private async Task InitiateStripeCheckout()
    {
        isCheckoutLoading = true;
        try
        {
            var response = await Http.PostAsync("/api/stripe/checkout", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<StripeCheckoutResponse>();
                if (!string.IsNullOrEmpty(result?.Url))
                {
                    await JS.InvokeVoidAsync("open", result.Url, "_self");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Stripe error: {ex.Message}");
        }
        finally
        {
            isCheckoutLoading = false;
        }
    }

    public class PersonalizationSession
    {
        public bool IsAuthenticated { get; set; }
        public string UserId { get; set; } = "";
        public string Email { get; set; } = "";
        public string Name { get; set; } = "";
        public string SubscriptionTier { get; set; } = "free";
        public int CreditBalance { get; set; }
        public string AvatarUrl { get; set; } = "";
    }

    public class UserStatusResponse
    {
        public string UserId { get; set; } = "";
        public string Tier { get; set; } = "";
        public bool IsPro { get; set; }
    }

    public class StripeCheckoutResponse
    {
        public string Url { get; set; } = "";
    }
}
