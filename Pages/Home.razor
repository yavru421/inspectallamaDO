@page "/"

<PageTitle>InspectaLlama - Command Center</PageTitle>

<div style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
            <h1 class="gradient-title" style="font-size: 2.2rem; font-weight: 800;">Command Center</h1>
            <p style="color: var(--text-muted); margin-top: 0.25rem;">Zero-Liability Architecture (ZLA) Local-First Research Runtimes</p>
        </div>
        <span class="badge-tag badge-zla">100% Client-Side WASM</span>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
    <div class="glass-card">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Active Research Tracks</div>
        <div style="font-size: 2.5rem; font-weight: 800; color: var(--text-main); margin: 0.5rem 0;">@activeTracksCount</div>
        <div style="font-size: 0.8rem; color: var(--accent-emerald);">● Running local-first WASM state</div>
    </div>

    <div class="glass-card">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">In-Memory Records</div>
        <div style="font-size: 2.5rem; font-weight: 800; color: var(--accent-cyan); margin: 0.5rem 0;">1,420</div>
        <div style="font-size: 0.8rem; color: var(--text-muted);">IndexedDB & Memory Primitives</div>
    </div>

    <div class="glass-card">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Infrastructure Cost</div>
        <div style="font-size: 2.5rem; font-weight: 800; color: var(--accent-emerald); margin: 0.5rem 0;">$0.00</div>
        <div style="font-size: 0.8rem; color: var(--accent-emerald);">Zero Server Liabilities</div>
    </div>
</div>

<div class="glass-card" style="margin-bottom: 2rem;">
    <h3 style="margin-bottom: 1rem; color: var(--text-main);">Fast Execution Console</h3>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.25rem;">
        Trigger real-time WASM state updates directly in client memory without network round-trips.
    </p>
    <div style="display: flex; gap: 1rem;">
        <button class="btn-primary-custom" @onclick="IncrementTracks">Add Research Track (+1)</button>
        <NavLink href="research" class="btn-secondary-custom" style="text-decoration: none; display: inline-flex; align-items: center;">
            Launch Research Engine &rarr;
        </NavLink>
    </div>
</div>

@code {
    private int activeTracksCount = 4;

    private void IncrementTracks()
    {
        activeTracksCount++;
    }
}
