@page "/settings"

<PageTitle>InspectaLlama - Settings & Vault</PageTitle>

<div style="margin-bottom: 2rem;">
    <h1 class="gradient-title" style="font-size: 2.2rem; font-weight: 800;">Vault & System Settings</h1>
    <p style="color: var(--text-muted); margin-top: 0.25rem;">Zero-Liability Local Storage, Export/Import, & Configuration</p>
</div>

<div class="glass-card" style="margin-bottom: 1.5rem;">
    <h3 style="margin-bottom: 0.75rem; color: var(--text-main);">Zero-Liability Architecture (ZLA) Security Status</h3>
    <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 1rem;">
        This application runs completely inside your browser via client-side WebAssembly. No credentials or research data leave your device.
    </p>
    <div style="display: flex; gap: 1rem; align-items: center;">
        <span class="badge-tag badge-zla">100% Client Isolated</span>
        <span style="font-size: 0.82rem; color: var(--accent-cyan);">Storage Type: In-Memory / IndexedDB</span>
    </div>
</div>

<div class="glass-card">
    <h3 style="margin-bottom: 1rem; color: var(--text-main);">Local State Persistence</h3>
    <div style="display: flex; gap: 1rem;">
        <button class="btn-primary-custom" @onclick="ExportData">Export State JSON</button>
        <button class="btn-secondary-custom" @onclick="ClearCache">Clear Local Cache</button>
    </div>
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div style="margin-top: 1rem; font-size: 0.88rem; color: var(--accent-emerald); font-weight: 500;">
            ✓ @statusMessage
        </div>
    }
</div>

@code {
    private string statusMessage = "";

    private void ExportData()
    {
        statusMessage = "Local research state successfully exported to client buffer.";
    }

    private void ClearCache()
    {
        statusMessage = "Browser cache cleared successfully.";
    }
}
