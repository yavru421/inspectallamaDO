@page "/"
@layout Layout.AppLayout
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ResearchStateService PipelineState
@inject IJSRuntime JS

<PageTitle>InspectaLlama &bull; Pinnacle Deep Semantic AI Research (Step 1)</PageTitle>

<div class="glass-card" style="max-width: 820px; margin: 3rem auto; padding: 2.5rem; border-color: var(--border-indigo); text-align: center;">
    <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1rem;">
        <span class="badge-tag badge-zla">PIPELINE STEP 1 OF 5</span>
        <span style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; color: var(--accent-indigo);">&bull; Llama 3.3 70B Edge Router</span>
    </div>

    <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: #fff; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 1rem;">
        Cognitive Research with <span class="gradient-title">Pinnacle AI Precision</span>
    </h1>

    <p style="color: var(--text-muted); font-size: 1rem; max-width: 580px; margin: 0 auto 2rem; line-height: 1.6;">
        Autonomous web graph traversal, dialectical claim verification, and source audits — powered by Cloudflare Workers AI edge runtime.
    </p>

    <div style="background: rgba(0,0,0,0.4); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
        <div style="display: flex; gap: 0.75rem; align-items: center;">
            <input @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleKeyUp"
                   placeholder="Ask any complex research topic to initiate the pipeline..."
                   style="flex: 1; background: transparent; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.85rem 1.1rem; color: var(--text-main); font-size: 1rem; outline: none; font-family: 'Inter', sans-serif;" />
            <button @onclick="StartPipeline" disabled="@(string.IsNullOrWhiteSpace(searchQuery))"
                    class="btn-primary-custom" style="padding: 0.85rem 1.75rem; font-weight: 800; font-size: 1rem; white-space: nowrap;">
                Initiate Grill-Me &rarr;
            </button>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-color); padding-top: 0.85rem; font-size: 0.82rem; color: var(--text-muted); flex-wrap: wrap; gap: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span style="color: var(--text-dim);">Research Mode:</span>
                <button @onclick='() => selectedMode = "deep_reasoning"'
                        style="padding: 0.35rem 0.85rem; border-radius: var(--radius-sm); border: 1px solid @(selectedMode == "deep_reasoning" ? "var(--border-indigo)" : "var(--border-color)"); background: @(selectedMode == "deep_reasoning" ? "rgba(99,102,241,0.2)" : "transparent"); color: @(selectedMode == "deep_reasoning" ? "var(--accent-indigo)" : "var(--text-dim)"); cursor: pointer; font-weight: 700; font-size: 0.78rem;">
                    🧠 Deep Multi-Hop
                </button>
                <button @onclick='() => selectedMode = "standard"'
                        style="padding: 0.35rem 0.85rem; border-radius: var(--radius-sm); border: 1px solid @(selectedMode == "standard" ? "var(--border-cyan)" : "var(--border-color)"); background: @(selectedMode == "standard" ? "rgba(6,182,212,0.15)" : "transparent"); color: @(selectedMode == "standard" ? "var(--accent-cyan)" : "var(--text-dim)"); cursor: pointer; font-weight: 700; font-size: 0.78rem;">
                    ⚡ Instant Audit
                </button>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.78rem; font-weight: 600;">
                    <input type="checkbox" @bind="deepCrawl" />
                    <span>Deep Multi-Tab Traversal</span>
                </label>
            </div>
        </div>
    </div>

    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.6rem; font-size: 0.82rem; color: var(--text-dim);">
        <span>Try Preset Research Topics:</span>
        <button @onclick='() => RunPreset("Cloudflare Workers AI Llama 3.3 70B Edge Router Architecture")' style="background: none; border: none; color: var(--accent-cyan); text-decoration: underline; cursor: pointer; font-weight: 600;">Workers AI Edge</button> &bull;
        <button @onclick='() => RunPreset("Zero-Liability Architecture (ZLA) vs Traditional Serverful SaaS")' style="background: none; border: none; color: var(--accent-indigo); text-decoration: underline; cursor: pointer; font-weight: 600;">ZLA Architecture</button>
    </div>
</div>

<div style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 3rem;">
    <a href="/grill" class="glass-card" style="padding: 1rem 1.5rem; text-decoration: none; color: var(--text-main); font-weight: 700; font-size: 0.88rem; display: flex; align-items: center; gap: 0.5rem;">
        <span>🎯 Step 2: Grill-Me Interrogation</span> &rarr;
    </a>
    <a href="/evaluator" class="glass-card" style="padding: 1rem 1.5rem; text-decoration: none; color: var(--text-main); font-weight: 700; font-size: 0.88rem; display: flex; align-items: center; gap: 0.5rem;">
        <span>⚡ Step 3: Vector Audit</span> &rarr;
    </a>
    <a href="/research" class="glass-card" style="padding: 1rem 1.5rem; text-decoration: none; color: var(--text-main); font-weight: 700; font-size: 0.88rem; display: flex; align-items: center; gap: 0.5rem;">
        <span>📄 Step 4: Executive Synthesis</span> &rarr;
    </a>
</div>

@code {
    private string searchQuery = "";
    private string selectedMode = "deep_reasoning";
    private bool deepCrawl = true;

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
            StartPipeline();
    }

    private void RunPreset(string query)
    {
        searchQuery = query;
        StartPipeline();
    }

    private void StartPipeline()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        PipelineState.StartNewPipeline(searchQuery);
        NavManager.NavigateTo("grill");
    }
}
