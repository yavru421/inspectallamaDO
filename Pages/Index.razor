@page "/"
@layout Layout.AppLayout
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>InspectaLlama &bull; Pinnacle Deep Semantic AI Research</PageTitle>

@* Floating Mobile Bottom Screen Navigation Dock *@
<div style="position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%); z-index: 100; background: rgba(13, 19, 34, 0.88); backdrop-filter: blur(16px); border: 1px solid rgba(6, 182, 212, 0.25); border-radius: 999px; padding: 0.5rem 0.85rem; box-shadow: 0 8px 32px rgba(0,0,0,0.5), 0 0 20px rgba(6, 182, 212, 0.1); display: flex; align-items: center; gap: 0.6rem; font-size: 0.78rem; font-weight: 700; color: var(--text-muted);">
    <button @onclick='() => ScrollToScreen("screen-search")'
            style="padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid var(--border-cyan); background: rgba(6, 182, 212, 0.15); color: var(--accent-cyan); cursor: pointer; display: flex; align-items: center; gap: 0.4rem; transition: all 0.2s;">
        <span>🔍</span><span>Search</span>
    </button>
    <button @onclick='() => ScrollToScreen("screen-synthesis")'
            style="padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid transparent; background: transparent; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; gap: 0.4rem; transition: all 0.2s;">
        <span>🧠</span><span>Synthesis</span>
    </button>
    <button @onclick='() => ScrollToScreen("screen-data")'
            style="padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid transparent; background: transparent; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; gap: 0.4rem; transition: all 0.2s;">
        <span>🌐</span><span>Data</span>
    </button>
    <button @onclick='() => ScrollToScreen("screen-grill")'
            style="padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid transparent; background: transparent; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; gap: 0.4rem; transition: all 0.2s;">
        <span>🎯</span><span>Grill Me</span>
    </button>
    <div style="width: 1px; height: 18px; background: var(--border-color); margin: 0 0.25rem;"></div>
    <a href="/evaluator" style="padding: 0.4rem 0.9rem; border-radius: 999px; border: 1px solid var(--border-indigo); background: rgba(99, 102, 241, 0.12); color: var(--accent-indigo); cursor: pointer; display: flex; align-items: center; gap: 0.4rem; text-decoration: none; font-size: 0.75rem;">⚡ Tools</a>
</div>

<div style="width: 100%; height: 100vh; display: flex; flex-direction: column; overflow-y: auto; scroll-snap-type: y mandatory; scroll-behavior: smooth; background: radial-gradient(circle at top left, rgba(6, 182, 212, 0.07), transparent 40%), radial-gradient(circle at bottom right, rgba(99, 102, 241, 0.07), transparent 40%), var(--bg-primary);" id="app-swiper">
    
    @* SCREEN 1: Search & Scraper *@
    <section id="screen-search" style="width: 100%; height: 100vh; flex-shrink: 0; scroll-snap-align: start; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; position: relative; overflow-y: auto;">
        <div style="width: 100%; max-width: 780px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.5rem; padding-top: 4rem;">
            
            @if (showPaymentAlert)
            {
                <div class="glass-card" style="width: 100%; padding: 1rem 1.25rem; border-color: rgba(16, 185, 129, 0.4); background: rgba(16, 185, 129, 0.12); color: var(--accent-emerald); font-size: 0.88rem; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.2rem;">🎉</span>
                        <span style="font-weight: 700;">Welcome to Inspecta Pro! Your account has been upgraded.</span>
                    </div>
                    <button @onclick="() => showPaymentAlert = false" style="background: none; border: none; color: var(--accent-emerald); font-weight: 800; cursor: pointer; font-size: 1.2rem;">&times;</button>
                </div>
            }

            @if (rateLimitHit)
            {
                <div class="glass-card" style="width: 100%; padding: 1rem 1.25rem; border-color: rgba(245, 158, 11, 0.4); background: rgba(245, 158, 11, 0.12); color: var(--accent-amber); font-size: 0.88rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.2rem;">⏳</span>
                        <div>
                            <span style="font-weight: 700;">Edge search quota threshold reached.</span>
                            <span style="color: rgba(245, 158, 11, 0.8); margin-left: 0.5rem;">Resets in @TimeUntilMidnightUtc.</span>
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="glass-card" style="width: 100%; padding: 1rem 1.25rem; border-color: rgba(244, 63, 94, 0.4); background: rgba(244, 63, 94, 0.12); color: var(--accent-rose); font-size: 0.88rem; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.2rem;">⚠️</span>
                        <div>
                            <span style="font-weight: 700;">Search Execution Notice:</span>
                            <span style="margin-left: 0.5rem;">@errorMessage</span>
                        </div>
                    </div>
                    <button @onclick="() => errorMessage = null" style="background: none; border: none; color: var(--accent-rose); font-weight: 800; cursor: pointer; font-size: 1.2rem;">&times;</button>
                </div>
            }

            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div class="do-power-badge" title="Stateless edge AI routing powered by Cloudflare Workers AI">
                    <span class="do-bolt">⚡</span>
                    <span class="do-label">POWERED BY <strong class="do-highlight">CLOUDFLARE WORKERS AI</strong></span>
                </div>
                <span style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; color: var(--accent-indigo);">&bull; Llama 3.3 70B Edge Router</span>
            </div>
            
            <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 900; color: #fff; letter-spacing: -0.03em; line-height: 1.1;">
                Cognitive Research with <span class="gradient-title">Pinnacle AI Precision</span>
            </h1>
            <p style="color: var(--text-muted); font-size: 0.95rem; max-width: 540px;">Autonomous web graph traversal, dialectical claim verification, and source audits — powered by Cloudflare Workers AI edge runtime.</p>

            <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-card); backdrop-filter: blur(12px); padding: 0.4rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); font-size: 0.82rem; font-weight: 700; width: 100%; max-width: 360px;">
                <button @onclick='() => mainTab = "search"'
                        style="flex: 1; padding: 0.6rem 1rem; border-radius: var(--radius-sm); border: 1px solid @(mainTab == "search" ? "var(--border-indigo)" : "transparent"); background: @(mainTab == "search" ? "rgba(99,102,241,0.25)" : "transparent"); color: @(mainTab == "search" ? "#fff" : "var(--text-muted)"); cursor: pointer; transition: all 0.2s;">
                    🧠 Deep Search
                </button>
                <button @onclick='() => mainTab = "scraper"'
                        style="flex: 1; padding: 0.6rem 1rem; border-radius: var(--radius-sm); border: 1px solid @(mainTab == "scraper" ? "var(--border-cyan)" : "transparent"); background: @(mainTab == "scraper" ? "rgba(6,182,212,0.2)" : "transparent"); color: @(mainTab == "scraper" ? "var(--accent-cyan)" : "var(--text-muted)"); cursor: pointer; transition: all 0.2s;">
                    ⚡ URL Scraper
                </button>
            </div>

            @if (mainTab == "search")
            {
                <div style="width: 100%; background: var(--bg-card); backdrop-filter: blur(16px); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1rem; box-shadow: var(--shadow-heavy); display: flex; flex-direction: column; gap: 0.75rem;">
                    <div style="display: flex; gap: 0.75rem; align-items: center;">
                        <input @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleKeyUp"
                               placeholder="Ask any complex research question..."
                               disabled="@(isLoading || rateLimitHit)"
                               style="flex: 1; background: transparent; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.85rem 1.1rem; color: var(--text-main); font-size: 1rem; outline: none; font-family: 'Inter', sans-serif;" />
                        <button @onclick="PerformSearch" disabled="@(isLoading || rateLimitHit || string.IsNullOrWhiteSpace(searchQuery))"
                                style="background: var(--gradient-brand); color: #fff; border: none; padding: 0.85rem 1.5rem; border-radius: var(--radius-sm); font-weight: 800; font-size: 0.95rem; cursor: pointer; box-shadow: var(--shadow-glow); white-space: nowrap; transition: all 0.2s; opacity: @(isLoading || rateLimitHit || string.IsNullOrWhiteSpace(searchQuery) ? 0.4 : 1);">
                            @if (isLoading) { <span>🔄 Reasoning...</span> } else { <span>Inspect 🦙</span> }
                        </button>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border-color); padding-top: 0.75rem; font-size: 0.78rem; color: var(--text-muted); flex-wrap: wrap; gap: 0.75rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="color: var(--text-dim);">Engine:</span>
                            <button @onclick='() => selectedMode = "deep_reasoning"'
                                    style="padding: 0.3rem 0.7rem; border-radius: var(--radius-sm); border: 1px solid @(selectedMode == "deep_reasoning" ? "var(--border-indigo)" : "var(--border-color)"); background: @(selectedMode == "deep_reasoning" ? "rgba(99,102,241,0.2)" : "transparent"); color: @(selectedMode == "deep_reasoning" ? "var(--accent-indigo)" : "var(--text-dim)"); cursor: pointer; font-weight: 600; font-size: 0.75rem;">
                                🧠 Deep Multi-Hop
                            </button>
                            <button @onclick='() => selectedMode = "standard"'
                                    style="padding: 0.3rem 0.7rem; border-radius: var(--radius-sm); border: 1px solid @(selectedMode == "standard" ? "var(--border-cyan)" : "var(--border-color)"); background: @(selectedMode == "standard" ? "rgba(6,182,212,0.15)" : "transparent"); color: @(selectedMode == "standard" ? "var(--accent-cyan)" : "var(--text-dim)"); cursor: pointer; font-weight: 600; font-size: 0.75rem;">
                                ⚡ Instant
                            </button>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.75rem;">
                                <input type="checkbox" @bind="deepCrawl" />
                                <span>Deep Multi-Tab</span>
                            </label>
                            @if (userStatus != null)
                            {
                                @if (userStatus.IsPro)
                                {
                                    <span class="badge-tag" style="background: rgba(99,102,241,0.15); color: var(--accent-indigo); border: 1px solid var(--border-indigo);">✦ Pro Pass</span>
                                }
                                else
                                {
                                    <span class="badge-tag" style="background: var(--bg-secondary); color: var(--text-muted); border: 1px solid var(--border-color);">🔍 @userStatus.SearchesRemaining/@userStatus.DailyLimit left</span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.78rem; color: var(--text-dim);">
                    <span>Try Presets:</span>
                    <button @onclick='() => RunPreset("Cloudflare Workers AI Llama 3.3 70B Edge Router")' style="background: none; border: none; color: var(--text-muted); text-decoration: underline; cursor: pointer;">Workers AI Edge</button> &bull;
                    <button @onclick='() => RunPreset("Zero-Liability Architecture (ZLA) vs Traditional SaaS Backend")' style="background: none; border: none; color: var(--text-muted); text-decoration: underline; cursor: pointer;">ZLA Architecture</button>
                </div>
            }
            else
            {
                <div class="glass-card" style="width: 100%; border-color: var(--border-cyan); border-radius: var(--radius-lg); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.85rem; text-align: left;">
                    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 0.6rem;">
                        <div>
                            <span style="font-size: 0.75rem; color: var(--accent-cyan); font-family: 'JetBrains Mono', monospace; text-transform: uppercase; letter-spacing: 0.05em;">Stateless Edge Scraper</span>
                            <h3 style="font-size: 1.1rem; font-weight: 700; color: #fff;">Inspect Webpage URL Architecture</h3>
                        </div>
                        <span style="font-size: 0.75rem; color: var(--text-dim); font-family: 'JetBrains Mono', monospace;">Llama 3.3</span>
                    </div>

                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <input @bind="evalTargetUrl" placeholder="https://example.com"
                               style="flex: 1; background: rgba(0,0,0,0.5); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.6rem 1rem; color: var(--text-main); font-family: 'JetBrains Mono', monospace; font-size: 0.88rem; outline: none;" />
                        <button @onclick="RunUrlEvaluation" disabled="@isEvaluating"
                                class="btn-primary-custom" style="padding: 0.6rem 1.25rem; font-size: 0.88rem; white-space: nowrap;">
                            @if (isEvaluating)
                            {
                                <span>🔄 Auditing...</span>
                            }
                            else
                            {
                                <span>Run Scraper ⚡</span>
                            }
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(evalError))
                    {
                        <div style="font-size: 0.78rem; font-family: 'JetBrains Mono', monospace; color: var(--accent-rose); background: rgba(244,63,94,0.1); border: 1px solid rgba(244,63,94,0.25); padding: 0.65rem; border-radius: var(--radius-sm);">
                            @evalError
                        </div>
                    }

                    <div style="background: rgba(0,0,0,0.6); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem; font-size: 0.82rem; font-family: 'JetBrains Mono', monospace; color: var(--text-main); white-space: pre-wrap; max-height: 280px; overflow-y: auto;">
                        @(string.IsNullOrEmpty(evalResult) ? "Enter a target web URL above and click 'Run Scraper ⚡' to execute an automated architectural audit." : evalResult)
                    </div>
                </div>
            }
            
            <div style="margin-top: 1rem; color: var(--text-dim); display: flex; flex-direction: column; align-items: center; gap: 0.25rem;">
                <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;">Scroll down or tap floating dock below to explore screens ↓</span>
            </div>
        </div>
    </section>

    @* SCREEN 2: Synthesis *@
    <section id="screen-synthesis" style="width: 100%; height: 100vh; flex-shrink: 0; scroll-snap-align: start; display: flex; flex-direction: column; justify-content: flex-start; padding: 2rem 2rem 5rem; overflow-y: auto;">
        <div style="max-width: 900px; margin: 2rem auto; width: 100%; display: flex; flex-direction: column; gap: 1.5rem;">
            @if (result != null)
            {
                <div class="glass-card" style="border-color: var(--border-indigo);">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-slate-800 pb-4 mb-6 gap-3">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 font-bold text-xs border border-indigo-500/30">
                                    @(result.Mode == "deep_reasoning" ? "🧠 Cognitive Multi-Hop Mode" : "⚡ Instant Search")
                                </span>
                                <span class="text-slate-500 font-mono text-xs">@result.Timestamp</span>
                            </div>
                            <h2 class="font-bold text-white text-xl sm:text-2xl mt-2">
                                Research Objective: "<span class="text-indigo-300">@result.Query</span>"
                            </h2>
                        </div>
                        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.78rem;">
                            <button @onclick="GeneratePdfReport" style="background: var(--gradient-brand); color: #fff; font-weight: 800; padding: 0.45rem 0.9rem; border-radius: var(--radius-sm); border: none; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; font-size: 0.78rem;">
                                <span>📄 PDF</span>
                            </button>
                            <button @onclick="ExportAsMarkdown" style="background: var(--bg-secondary); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color); cursor: pointer; font-size: 0.78rem;">
                                📥 MD
                            </button>
                        </div>
                    </div>
                    
                    <h3 style="font-size: 0.72rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem;">Executive Synthesis</h3>
                    <div style="color: var(--text-main); font-size: 0.9rem; line-height: 1.7; white-space: pre-line;">
                        @result.Synthesis
                    </div>

                    @if (result.ReasoningTrace.Any())
                    {
                        <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
                            <h4 style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem;">Cognitive Reasoning Trace</h4>
                            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                @foreach (var step in result.ReasoningTrace)
                                {
                                    <div style="font-size: 0.78rem; color: var(--text-muted); display: flex; align-items: flex-start; gap: 0.6rem;">
                                        <span style="width: 1.35rem; height: 1.35rem; border-radius: 50%; background: rgba(99,102,241,0.15); border: 1px solid rgba(99,102,241,0.3); color: var(--accent-indigo); display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 900; flex-shrink: 0; margin-top: 0.1rem;">@step.Step</span>
                                        <span style="line-height: 1.5;">@step.Description</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="glass-card" style="padding: 3rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                    <span style="font-size: 3.5rem; opacity: 0.35;">🧠</span>
                    <h3 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); font-family: 'Outfit', sans-serif;">Executive Synthesis Pending</h3>
                    <p style="font-size: 0.9rem; color: var(--text-muted); max-width: 400px; line-height: 1.6;">Submit a research query on Screen 1 to generate an autonomous edge-synthesized intelligence brief.</p>
                    <button @onclick='() => ScrollToScreen("screen-search")' class="btn-primary-custom" style="margin-top: 0.5rem;">← Back to Search</button>
                </div>
            }
        </div>
    </section>

    @* SCREEN 3: Data Matrix (Claims & Entities) *@
    <section id="screen-data" style="width: 100%; height: 100vh; flex-shrink: 0; scroll-snap-align: start; display: flex; flex-direction: column; padding: 2rem 2rem 5rem; overflow-y: auto;">
        <div style="max-width: 1100px; margin: 2rem auto; width: 100%; display: flex; flex-direction: column; gap: 2rem;">
            @if (result != null)
            {
                @if (result.Claims.Any())
                {
                    <div style="margin-bottom: 1rem;">
                        <h3 style="font-size: 0.72rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                            <span>🔍 Verified Claims Matrix</span>
                            <span style="padding: 0.15rem 0.5rem; border-radius: 999px; background: rgba(99,102,241,0.15); color: var(--accent-indigo); font-size: 0.65rem;">@result.Claims.Count</span>
                        </h3>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem;">
                            @foreach (var claim in result.Claims)
                            {
                                <div class="glass-card" style="display: flex; flex-direction: column; justify-content: space-between; gap: 0.75rem;">
                                    <div>
                                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem; gap: 0.5rem;">
                                            <span style="padding: 0.15rem 0.55rem; border-radius: 999px; font-weight: 800; font-size: 0.65rem; @GetEpistemicBadgeStyle(claim.EpistemicStatus)">@claim.EpistemicStatus</span>
                                            <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 0.4rem;">
                                                @claim.ConfidenceScore%
                                                <div style="width: 2rem; height: 4px; background: var(--bg-secondary); border-radius: 999px; overflow: hidden;">
                                                    <div style="background: var(--accent-indigo); height: 100%; width: @(claim.ConfidenceScore)%;"></div>
                                                </div>
                                            </span>
                                        </div>
                                        <p style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">@claim.Statement</p>
                                        <p style="font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; color: var(--text-muted); font-style: italic; background: rgba(0,0,0,0.25); padding: 0.5rem 0.65rem; border-radius: var(--radius-sm); margin-top: 0.5rem; border: 1px solid var(--border-color);">
                                            "@claim.VerbatimQuote"
                                        </p>
                                    </div>
                                    <div style="padding-top: 0.5rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; font-size: 0.68rem;">
                                        <a href="@claim.SourceUrl" target="_blank" style="color: var(--accent-indigo); text-decoration: none; max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@claim.SourceTitle</a>
                                        <button @onclick='() => RunPreset($"Deep research details on {claim.Statement}")' style="padding: 0.25rem 0.5rem; border-radius: var(--radius-sm); background: var(--bg-secondary); color: var(--text-muted); border: 1px solid var(--border-color); cursor: pointer; font-size: 0.68rem;">
                                            Sub-Crawl
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (result.Entities.Any())
                {
                    <div style="padding-top: 1rem; border-top: 1px solid var(--border-color);">
                        <h3 style="font-size: 0.72rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                            <span>🌐 Entity Knowledge Graph</span>
                            <span style="padding: 0.15rem 0.5rem; border-radius: 999px; background: rgba(99,102,241,0.15); color: var(--accent-indigo); font-size: 0.65rem;">@result.Entities.Count</span>
                        </h3>
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
                            @foreach (var entity in result.Entities)
                            {
                                <div class="glass-card" style="display: flex; flex-direction: column; justify-content: space-between;">
                                    <div>
                                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.5rem;">
                                            <h4 style="font-weight: 800; color: var(--accent-indigo); font-size: 0.88rem;">@entity.Name</h4>
                                            <span style="padding: 0.1rem 0.4rem; border-radius: var(--radius-sm); background: var(--bg-secondary); color: var(--text-muted); font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">@entity.Category</span>
                                        </div>
                                        <p style="font-size: 0.78rem; color: var(--text-main); line-height: 1.5;">@entity.Description</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="glass-card" style="padding: 2.5rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                    <span style="font-size: 3rem; opacity: 0.35;">🌐</span>
                    <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); font-family: 'Outfit', sans-serif;">Data Matrix Awaiting Telemetry</h3>
                    <p style="font-size: 0.88rem; color: var(--text-muted); max-width: 380px; line-height: 1.6;">Claim verification matrices and knowledge graphs will materialize here once search execution completes.</p>
                    <button @onclick='() => ScrollToScreen("screen-search")' class="btn-primary-custom" style="margin-top: 0.5rem;">← Back to Search</button>
                </div>
            }
        </div>
    </section>

    @* SCREEN 4: The /grill-me Stepper Deck *@
    <section id="screen-grill" style="width: 100%; height: 100vh; flex-shrink: 0; scroll-snap-align: start; display: flex; flex-direction: column; padding: 2rem 2rem 5rem; overflow: hidden; background: radial-gradient(circle at top, rgba(99, 102, 241, 0.06), transparent 60%);">
        <div style="max-width: 860px; margin: 0 auto; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center;">
            <div style="text-align: center; margin-bottom: 1.5rem;">
                <span style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">🎯</span>
                <h3 style="font-family: 'Outfit', sans-serif; font-weight: 900; font-size: 1.75rem; color: var(--text-main); letter-spacing: -0.02em;">Interactive Decision Engine</h3>
                <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 0.35rem;">The AI paused at key research branches. Select your paths for downstream evaluation.</p>
            </div>

            @if (result != null && result.GrillNodes != null && result.GrillNodes.Any())
            {
                var resolvedCount = result.GrillNodes.Count(n => n.IsResolved);
                var totalCount = result.GrillNodes.Count;
                var allResolved = resolvedCount == totalCount;
                var progressPct = (int)((float)resolvedCount / totalCount * 100);

                <div class="w-full mb-4 shrink-0 bg-[var(--bg-panel)] p-4 rounded-xl border border-[var(--border-dim)] flex items-center justify-between shadow-lg">
                    <div class="flex flex-col gap-1 w-full max-w-[200px]">
                        <span class="text-xs font-bold text-[var(--text-dark-muted)] uppercase tracking-wider">Decision Progress</span>
                        <div class="w-full h-2 bg-[rgba(255,255,255,0.05)] rounded-full overflow-hidden">
                            <div class="h-full bg-[var(--brand-accent)] transition-all duration-500 ease-out" style="width: @(progressPct)%"></div>
                        </div>
                    </div>
                    <span class="text-sm font-black font-mono @(allResolved ? "text-[var(--brand-accent)]" : "text-[var(--text-white)]")">
                        @resolvedCount / @totalCount
                    </span>
                </div>

                <div class="w-full flex-1 overflow-x-auto snap-x snap-mandatory flex gap-6 pb-8 hide-scrollbar scroll-smooth items-center">
                    @foreach (var node in result.GrillNodes)
                    {
                        <div id="node-@node.NodeId" class="w-[90%] sm:w-full max-w-2xl shrink-0 snap-center snap-always p-6 sm:p-8 rounded-2xl bg-[var(--bg-panel)] border @(node.IsResolved ? "border-[var(--brand-accent)] ring-1 ring-[var(--brand-accent)]" : "border-[rgba(240,136,62,0.3)]") shadow-2xl space-y-6 flex flex-col h-full max-h-[70vh] overflow-y-auto hide-scrollbar relative">
                            @if (node.IsResolved)
                            {
                                <div class="absolute inset-0 bg-[var(--brand-accent)]/5 rounded-2xl pointer-events-none"></div>
                            }
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-dim)] pb-4 shrink-0">
                                <span class="px-3 py-1.5 rounded-full text-[10px] font-black font-mono uppercase tracking-widest @(node.IsResolved ? "bg-[rgba(35,134,54,0.15)] text-[var(--brand-accent)]" : "bg-[rgba(240,136,62,0.15)] text-[#f0883e]")">
                                    Node #@node.StepIndex &bull; @(node.IsResolved ? "✓ Resolved" : "⏳ Awaiting Selection")
                                </span>
                                @if (!string.IsNullOrEmpty(node.SelectedOption))
                                {
                                    <span class="text-[10px] text-[var(--brand-accent)] font-bold bg-[rgba(35,134,54,0.1)] px-2 py-1 rounded border border-[rgba(35,134,54,0.2)] truncate max-w-[200px]">
                                        @node.SelectedOption
                                    </span>
                                }
                            </div>
                            
                            <div class="shrink-0">
                                <h4 class="font-black text-[var(--text-white)] text-xl sm:text-2xl tracking-tight mb-3 leading-tight">@node.Title</h4>
                                <p class="text-base text-[var(--text-white)] opacity-90 leading-relaxed font-medium">@node.ContextQuestion</p>
                            </div>

                            <div class="grid grid-cols-1 gap-3 mt-auto relative z-10">
                                @foreach (var opt in node.Options)
                                {
                                    var isCurrentSelected = node.SelectedOption == opt.Text;
                                    <div @onclick='() => SelectGrillOption(node, opt)'
                                         class="group touch-target p-4 rounded-xl border transition-all duration-200 cursor-pointer select-none @(isCurrentSelected ? "bg-[rgba(35,134,54,0.1)] border-[var(--brand-accent)] text-[var(--text-white)] shadow-md" : opt.IsRecommended ? "bg-[rgba(240,136,62,0.05)] border-[rgba(240,136,62,0.3)] hover:border-[#f0883e]" : "bg-[rgba(22,27,34,0.5)] border-[var(--border-dim)] hover:border-[rgba(139,148,158,0.5)]") flex flex-col gap-2">
                                        
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="flex items-center gap-2">
                                                @if (opt.IsRecommended)
                                                {
                                                    <span class="px-1.5 py-0.5 rounded bg-[rgba(240,136,62,0.2)] text-[#f0883e] font-black text-[9px] uppercase shadow-sm shrink-0" title="AI Recommended Option">★</span>
                                                }
                                                <span class="font-bold text-[15px] @(isCurrentSelected ? "text-[var(--brand-accent)]" : "text-[var(--text-white)]") group-hover:text-white transition-colors">@opt.Text</span>
                                            </div>
                                            <div class="shrink-0 pt-0.5">
                                                <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors @(isCurrentSelected ? "border-[var(--brand-accent)] bg-[var(--brand-accent)]" : "border-[var(--border-dim)] group-hover:border-[var(--text-dark-muted)]")">
                                                    @if (isCurrentSelected) { <span class="text-white text-[10px] font-black">✓</span> }
                                                </div>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(opt.Rationale))
                                        {
                                            <p class="text-xs text-[var(--text-dark-muted)] leading-relaxed pl-1 border-l-2 border-[var(--border-dim)] ml-1 @(isCurrentSelected ? "border-[var(--brand-accent)] opacity-100" : "opacity-80 group-hover:opacity-100")">
                                                @opt.Rationale
                                            </p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="shrink-0 flex justify-center mt-4">
                    @if (isLoading)
                    {
                        <div class="w-full sm:w-auto touch-target text-white font-black px-10 py-4 rounded-full shadow-2xl flex items-center justify-center gap-3 text-lg border bg-[var(--brand-accent)] border-[var(--brand-accent)]">
                            <span class="animate-spin text-xl">🔄</span>
                            <span>Executing Edge Hop...</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-[var(--text-dark-muted)] text-sm font-semibold">
                            @if (!allResolved)
                            {
                                <span>Resolve @(totalCount - resolvedCount) more nodes to continue.</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-16 bg-[var(--bg-panel)] border border-[var(--border-dim)] rounded-2xl p-8 shadow-lg max-w-lg mx-auto">
                    <span class="text-4xl mb-4 block opacity-60 animate-bounce">🧭</span>
                    <h4 class="font-bold text-[var(--text-white)] text-xl">No Active Decision Nodes</h4>
                    <p class="text-sm text-[var(--text-dark-muted)] mt-2 leading-relaxed">
                        Run a query in 🧠 <strong>Deep Multi-Hop Mode</strong> on Screen 1 to generate an interactive decision deck.
                    </p>
                    <button @onclick='() => ScrollToScreen("screen-search")' class="mt-4 px-6 py-2.5 rounded-full bg-[var(--brand-accent)] hover:bg-[var(--brand-accent-hover)] text-white font-bold text-xs transition">
                        Go to Search (Screen 1)
                    </button>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private string searchQuery = "";
    private string selectedMode = "deep_reasoning";
    private bool deepCrawl = true;
    private bool isLoading = false;
    private bool showPaymentAlert = false;
    private bool rateLimitHit = false;
    private string? errorMessage = null;
    private SearchResultResponse? result = null;
    private UserStatus? userStatus = null;

    private async Task ScrollToScreen(string screenId)
    {
        await JS.InvokeVoidAsync("zlaInterop.scrollToElement", screenId);
    }

    private string UsagePillClass => userStatus?.SearchesRemaining switch
    {
        0     => "bg-red-500/20 border border-red-500/40 text-red-300",
        1     => "bg-amber-500/20 border border-amber-500/40 text-amber-300",
        2     => "bg-amber-500/15 border border-amber-500/30 text-amber-400",
        _     => "bg-slate-800 border border-slate-700 text-slate-400"
    };

    private string TimeUntilMidnightUtc
    {
        get
        {
            var now = DateTime.UtcNow;
            var midnight = now.Date.AddDays(1);
            var diff = midnight - now;
            return diff.Hours > 0 ? $"{diff.Hours}h {diff.Minutes}m" : $"{diff.Minutes}m";
        }
    }

    private string GetEpistemicBadgeStyle(string status) => status switch
    {
        "Fact" => "background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4);",
        "Disputed" => "background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4);",
        "Marketing" => "background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4);",
        _ => "background: rgba(99, 102, 241, 0.2); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.4);"
    };

    private async Task EnsureJwtAttached()
    {
        var jwt = await JS.InvokeAsync<string>("zlaInterop.getJwtToken");
        if (!string.IsNullOrEmpty(jwt))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", jwt);
        }
        else
        {
            Http.DefaultRequestHeaders.Authorization = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        if (uri.Query.Contains("payment=success"))
            showPaymentAlert = true;

        // Initialization complete

        await RefreshUserStatus();
    }

    private async Task RefreshUserStatus()
    {
        try
        {
            await EnsureJwtAttached();
            var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            userStatus = await Http.GetFromJsonAsync<UserStatus>("/api/user/status", jsonOpts);
            rateLimitHit = false;
        }
        catch {
            rateLimitHit = false;
        }
    }

    private string mainTab = "search";
    private string evalTargetUrl = "";
    private string evalResult = "";
    private string evalError = "";
    private bool isEvaluating = false;

    private async Task RunUrlEvaluation()
    {
        if (string.IsNullOrWhiteSpace(evalTargetUrl))
        {
            evalError = "Please enter a valid target URL.";
            return;
        }

        isEvaluating = true;
        evalError = "";
        evalResult = "";

        try
        {
            await EnsureJwtAttached();
            var response = await Http.PostAsJsonAsync("/api/eval", new { targetUrl = evalTargetUrl });
            if (response.IsSuccessStatusCode)
            {
                var data = await response.Content.ReadFromJsonAsync<EvalResponse>();
                evalResult = data?.Evaluation ?? "Evaluation complete.";
            }
            else
            {
                evalError = $"Evaluation failed: HTTP {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            evalError = $"Network error: {ex.Message}";
        }
        finally
        {
            isEvaluating = false;
        }
    }

    private void RunPreset(string query)
    {
        searchQuery = query;
        PerformSearch();
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading && !rateLimitHit)
            PerformSearch();
    }

    @inject ResearchStateService PipelineState

    private void PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || rateLimitHit) return;
        PipelineState.StartNewPipeline(searchQuery);
        NavManager.NavigateTo("grill");
    }

    private async Task SelectGrillOption(InteractiveGrillNode node, GrillOption opt)
    {
        node.SelectedOption = opt.Text;
        node.IsResolved = true;
        
        var allResolved = result?.GrillNodes?.All(n => n.IsResolved) ?? false;
        if (allResolved)
        {
            await ExecuteGrillDownstreamHop();
        }
        else
        {
            var nextNode = result?.GrillNodes?.FirstOrDefault(n => !n.IsResolved);
            if (nextNode != null)
            {
                await JS.InvokeVoidAsync("zlaInterop.scrollToElement", "node-" + nextNode.NodeId);
            }
        }
    }

    private async Task ExecuteGrillDownstreamHop()
    {
        if (result == null || result.GrillNodes == null) return;
        var selected = result.GrillNodes
            .Where(n => n.IsResolved && !string.IsNullOrEmpty(n.SelectedOption))
            .Select(n => new { question = n.ContextQuestion, answer = n.SelectedOption })
            .ToList();

        if (!selected.Any()) return;

        isLoading = true;
        errorMessage = null;

        try
        {
            var payload = new
            {
                query = searchQuery,
                deepCrawl = deepCrawl,
                mode = selectedMode,
                selectedAnswers = selected
            };

            var response = await Http.PostAsJsonAsync("/api/search", payload);
            if (response.IsSuccessStatusCode)
            {
                var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                result = await response.Content.ReadFromJsonAsync<SearchResultResponse>(jsonOpts);
                await IncrementCreditTickerState(credits: 1, estimatedTokens: 800);
                await RefreshUserStatus();
                await ScrollToScreen("screen-synthesis");
            }
            else
            {
                var bodyText = await response.Content.ReadAsStringAsync();
                errorMessage = $"Downstream hop failed ({response.StatusCode}): {bodyText}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Downstream hop exception: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task IncrementCreditTickerState(int credits, int estimatedTokens)
    {
        try
        {
            var raw = await JS.InvokeAsync<string>("zlaInterop.getCreditTickerState");
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var state = System.Text.Json.JsonSerializer.Deserialize<InspectaLlamaDO.Models.CreditTickerState>(raw, opts) ?? new InspectaLlamaDO.Models.CreditTickerState();
            state.CreditsUsed += credits;
            state.TokensProcessed += estimatedTokens;
            var json = System.Text.Json.JsonSerializer.Serialize(state);
            await JS.InvokeVoidAsync("zlaInterop.saveCreditTickerState", json);
        }
        catch { }
    }

    private async Task GeneratePdfReport()
    {
        if (result == null) return;
        var opts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
        var json = System.Text.Json.JsonSerializer.Serialize(result, opts);
        await JS.InvokeVoidAsync("zlaInterop.generateExecutivePdf", json);
    }

    private async Task ExportAsMarkdown()
    {
        if (result == null) return;
        var md = $"# InspectaLlama AI Report: {result.Query}\n\n" +
                 $"**Timestamp:** {result.Timestamp}\n\n" +
                 $"## Edge AI Synthesis\n\n{result.Synthesis}\n\n" +
                 $"## Inspected Sources\n\n";
        foreach (var s in result.Sources)
        {
            md += $"- [{s.Title}]({s.Url}) - {s.Snippet}\n";
        }

        var fileName = $"inspectallama_{DateTime.UtcNow:yyyyMMdd_HHmmss}.md";
        await JS.InvokeVoidAsync("zlaInterop.downloadFile", fileName, md, "text/markdown;charset=utf-8");
    }
}
