@page "/"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JS

<PageTitle>InspectaLlama &bull; Pinnacle Deep Semantic AI Research</PageTitle>

@* Floating Mobile Bottom Screen Navigation Dock *@
<div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-slate-900/90 backdrop-blur-md border border-slate-700/80 rounded-full px-3 py-2 shadow-2xl flex items-center gap-1.5 sm:gap-3 text-xs font-bold text-slate-300 pointer-events-auto">
    <button @onclick='() => ScrollToScreen("screen-search")' 
            class="px-3 py-1.5 rounded-full transition flex items-center gap-1.5 bg-indigo-600/30 text-indigo-300 border border-indigo-500/50 hover:bg-indigo-600 hover:text-white">
        <span>🔍</span>
        <span class="hidden sm:inline">1. Search</span>
    </button>
    <button @onclick='() => ScrollToScreen("screen-synthesis")' 
            class="px-3 py-1.5 rounded-full transition flex items-center gap-1.5 hover:bg-slate-800 hover:text-white">
        <span>🧠</span>
        <span class="hidden sm:inline">2. Synthesis</span>
    </button>
    <button @onclick='() => ScrollToScreen("screen-data")' 
            class="px-3 py-1.5 rounded-full transition flex items-center gap-1.5 hover:bg-slate-800 hover:text-white">
        <span>🌐</span>
        <span class="hidden sm:inline">3. Data</span>
    </button>
    <button @onclick='() => ScrollToScreen("screen-grill")' 
            class="px-3 py-1.5 rounded-full transition flex items-center gap-1.5 hover:bg-slate-800 hover:text-white">
        <span>🎯</span>
        <span class="hidden sm:inline">4. Grill Me</span>
    </button>
</div>

<div class="w-full h-full flex overflow-x-auto snap-x snap-mandatory scroll-smooth hide-scrollbar bg-slate-950" id="app-swiper">
    
    @* SCREEN 1: Search & Scraper *@
    <section id="screen-search" class="w-full h-full shrink-0 snap-center snap-always flex flex-col items-center justify-center p-4 relative overflow-y-auto">
        <div class="w-full max-w-3xl flex flex-col items-center text-center space-y-6 pt-16 sm:pt-0">
            
            @if (showPaymentAlert)
            {
                <div class="w-full p-4 rounded-xl bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-sm flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">🎉</span>
                        <span class="font-bold">Welcome to Inspecta Pro! Your account has been upgraded.</span>
                    </div>
                    <button @onclick="() => showPaymentAlert = false" class="text-emerald-400 font-bold">&times;</button>
                </div>
            }

            @if (rateLimitHit)
            {
                <div class="w-full p-4 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-300 text-sm flex items-center justify-between flex-wrap gap-2">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">⏳</span>
                        <div>
                            <span class="font-bold">Daily free search quota reached.</span>
                            <span class="text-amber-400/80 ml-2">Resets in @TimeUntilMidnightUtc.</span>
                        </div>
                    </div>
                    <a href="https://personalization.dondlingergc.com/subscription" target="_blank" 
                       class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs px-4 py-2 rounded-lg transition inline-flex items-center gap-1">
                        Upgrade Pro →
                    </a>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="w-full p-4 rounded-xl bg-red-500/15 border border-red-500/30 text-red-300 text-sm flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">⚠️</span>
                        <div>
                            <span class="font-bold">Search Execution Notice:</span>
                            <span class="ml-2">@errorMessage</span>
                        </div>
                    </div>
                    <button @onclick="() => errorMessage = null" class="text-red-400 font-bold">&times;</button>
                </div>
            }

            <div class="flex items-center gap-3">
                <div class="do-power-badge" title="Stateless edge AI routing powered by Cloudflare Workers AI">
                    <span class="do-bolt">⚡</span>
                    <span class="do-label">POWERED BY <strong class="do-highlight">CLOUDFLARE WORKERS AI</strong></span>
                </div>
                <span class="text-xs font-mono text-indigo-400/80">&bull; Llama 3.3 70B Edge Router</span>
            </div>
            
            <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight">
                Cognitive Research with <span class="bg-gradient-to-r from-indigo-400 via-cyan-400 to-emerald-400 bg-clip-text text-transparent">Pinnacle AI Precision</span>
            </h1>
            <p class="text-slate-400 text-sm">
                Autonomous web graph traversal, dialectical claim verification, and source audits.
            </p>

            <div class="flex items-center gap-2 bg-slate-900/80 p-1.5 rounded-xl border border-slate-800 text-xs font-bold w-full sm:w-auto">
                <button @onclick='() => mainTab = "search"' class="flex-1 sm:flex-none px-4 py-2 rounded-lg transition border @(mainTab == "search" ? "bg-indigo-600 text-white border-indigo-500 shadow-md" : "bg-transparent text-slate-400 border-transparent hover:text-white")">
                    🧠 Deep Search
                </button>
                <button @onclick='() => mainTab = "scraper"' class="flex-1 sm:flex-none px-4 py-2 rounded-lg transition border @(mainTab == "scraper" ? "bg-cyan-600 text-white border-cyan-500 shadow-md" : "bg-transparent text-slate-400 border-transparent hover:text-white")">
                    ⚡ URL Scraper
                </button>
            </div>

            @if (mainTab == "search")
            {
                <div class="w-full bg-slate-900 border border-slate-800 rounded-2xl p-2.5 sm:p-3 shadow-2xl flex flex-col gap-3">
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                        <input @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleKeyUp"
                               placeholder="Ask any complex research question..."
                               disabled="@(isLoading || rateLimitHit)"
                               class="w-full bg-transparent px-3 py-2.5 sm:px-4 sm:py-3 text-slate-100 placeholder-slate-500 focus:outline-none text-sm sm:text-base disabled:opacity-50 disabled:cursor-not-allowed border border-slate-800 sm:border-0 rounded-xl sm:rounded-none" />
                        <button @onclick="PerformSearch" disabled="@(isLoading || rateLimitHit || string.IsNullOrWhiteSpace(searchQuery))"
                                class="bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold px-5 py-3 rounded-xl transition flex items-center justify-center gap-2 shrink-0 w-full sm:w-auto">
                            @if (isLoading)
                            {
                                <span class="animate-spin text-sm">🔄</span>
                                <span>Reasoning...</span>
                            }
                            else
                            {
                                <span>Inspect 🦙</span>
                            }
                        </button>
                    </div>

                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 px-2 py-2 border-t border-slate-800/60 text-xs text-slate-400">
                        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 w-full sm:w-auto">
                            <span class="text-slate-500 font-medium hidden sm:inline">Engine:</span>
                            <button @onclick='() => selectedMode = "deep_reasoning"'
                                    class="px-2 py-1 rounded-lg font-semibold transition text-[11px] sm:text-xs border @(selectedMode == "deep_reasoning" ? "bg-indigo-600/30 border-indigo-500/50 text-indigo-300" : "bg-slate-950/60 border-slate-800 text-slate-400")">
                                🧠 Deep Multi-Hop
                            </button>
                            <button @onclick='() => selectedMode = "standard"'
                                    class="px-2 py-1 rounded-lg font-semibold transition text-[11px] sm:text-xs border @(selectedMode == "standard" ? "bg-indigo-600/30 border-indigo-500/50 text-indigo-300" : "bg-slate-950/60 border-slate-800 text-slate-400")">
                                ⚡ Instant
                            </button>
                        </div>
                        <div class="flex items-center justify-between w-full sm:w-auto gap-3">
                            <label class="flex items-center gap-1.5 cursor-pointer hover:text-slate-200 transition text-[11px] sm:text-xs">
                                <input type="checkbox" @bind="deepCrawl" class="rounded bg-slate-950 border-slate-700 text-indigo-600" />
                                <span>Deep Multi-Tab</span>
                            </label>
                            @if (userStatus != null)
                            {
                                @if (userStatus.IsPro)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-indigo-500/20 border border-indigo-500/40 text-indigo-300 font-semibold text-[10px]">
                                        ✦ Pro Pass
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full @UsagePillClass font-mono text-[10px]">
                                        🔍 @userStatus.SearchesRemaining/@userStatus.DailyLimit left
                                    </span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-slate-500">
                    <span>Try Presets:</span>
                    <button @onclick='() => RunPreset("Cloudflare Workers AI Llama 3.3 70B Edge Router")' class="text-slate-400 hover:text-indigo-400 underline transition">Workers AI Edge</button> &bull;
                    <button @onclick='() => RunPreset("Zero-Liability Architecture (ZLA) vs Traditional SaaS Backend")' class="text-slate-400 hover:text-indigo-400 underline transition">ZLA Architecture</button>
                </div>
            }
            else
            {
                <div class="w-full bg-slate-900 border border-cyan-500/30 rounded-2xl p-4 shadow-2xl flex flex-col gap-3 text-left">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                        <div>
                            <span class="text-xs text-cyan-400 font-mono uppercase tracking-wide">Stateless Edge Scraper</span>
                            <h3 class="text-lg font-bold text-white">Inspect Webpage URL Architecture</h3>
                        </div>
                        <span class="text-xs text-slate-500 font-mono">Llama 3.3</span>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center gap-2 mt-1">
                        <input @bind="evalTargetUrl" placeholder="https://example.com"
                               class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-slate-100 font-mono text-sm placeholder-slate-600 focus:outline-none focus:border-cyan-500" />
                        <button @onclick="RunUrlEvaluation" disabled="@isEvaluating"
                                class="w-full sm:w-auto bg-cyan-600 hover:bg-cyan-500 text-white font-bold px-6 py-2.5 rounded-xl transition text-sm flex items-center justify-center gap-2 shrink-0 disabled:opacity-50">
                            @if (isEvaluating)
                            {
                                <span class="animate-spin text-sm">🔄</span>
                                <span>Auditing...</span>
                            }
                            else
                            {
                                <span>Run Scraper ⚡</span>
                            }
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(evalError))
                    {
                        <div class="text-xs font-mono text-red-400 bg-red-500/10 border border-red-500/20 p-2.5 rounded-xl">
                            @evalError
                        </div>
                    }

                    <div class="mt-2 bg-slate-950 border border-slate-800/80 rounded-xl p-4 text-xs font-mono text-cyan-200/90 whitespace-pre-wrap max-h-96 overflow-y-auto leading-relaxed shadow-inner">
                        @(string.IsNullOrEmpty(evalResult) ? "Enter a target web URL above and click 'Run Scraper ⚡' to execute an automated architectural audit." : evalResult)
                    </div>
                </div>
            }
            
            <div class="mt-4 animate-pulse text-slate-400 flex flex-col items-center gap-1">
                <span class="text-xs font-bold uppercase tracking-wider">Swipe right to explore results & stepper deck →</span>
            </div>
        </div>
    </section>

    @* SCREEN 2: Synthesis *@
    <section id="screen-synthesis" class="w-full h-full shrink-0 snap-center snap-always flex flex-col p-4 sm:p-8 pt-24 pb-20 relative overflow-y-auto hide-scrollbar">
        <div class="max-w-4xl mx-auto w-full space-y-6">
            @if (result != null)
            {
                <div class="bg-slate-900 border border-indigo-500/30 rounded-2xl p-6 shadow-xl">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-slate-800 pb-4 mb-6 gap-3">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 font-bold text-xs border border-indigo-500/30">
                                    @(result.Mode == "deep_reasoning" ? "🧠 Cognitive Multi-Hop Mode" : "⚡ Instant Search")
                                </span>
                                <span class="text-slate-500 font-mono text-xs">@result.Timestamp</span>
                            </div>
                            <h2 class="font-bold text-white text-xl sm:text-2xl mt-2">
                                Research Objective: "<span class="text-indigo-300">@result.Query</span>"
                            </h2>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 text-xs">
                            <button @onclick="GeneratePdfReport" class="bg-gradient-to-r from-indigo-600 to-cyan-600 hover:from-indigo-500 hover:to-cyan-500 text-white font-bold px-3 py-2 rounded-xl transition flex items-center gap-1.5">
                                <span>📄 PDF</span>
                            </button>
                            <button @onclick="ExportAsMarkdown" class="bg-slate-800 hover:bg-slate-700 text-slate-200 px-3 py-2 rounded-xl transition">
                                📥 MD
                            </button>
                        </div>
                    </div>
                    
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4">Executive Synthesis</h3>
                    <div class="prose prose-invert max-w-none text-slate-200 text-sm leading-relaxed whitespace-pre-line">
                        @result.Synthesis
                    </div>

                    @if (result.ReasoningTrace.Any())
                    {
                        <div class="mt-8 pt-6 border-t border-slate-800">
                            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Cognitive Reasoning Trace</h4>
                            <div class="space-y-2">
                                @foreach (var step in result.ReasoningTrace)
                                {
                                    <div class="text-xs text-slate-400 flex items-start gap-2">
                                        <span class="w-5 h-5 rounded-full bg-indigo-500/20 border border-indigo-500/40 text-indigo-300 flex items-center justify-center font-mono font-bold shrink-0 mt-0.5">@step.Step</span>
                                        <span class="leading-relaxed">@step.Description</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-10 text-center flex flex-col items-center justify-center space-y-4 my-auto">
                    <span class="text-5xl opacity-40">🧠</span>
                    <h3 class="text-xl font-bold text-white">Executive Synthesis Pending</h3>
                    <p class="text-sm text-slate-400 max-w-md">
                        Submit a research query on Screen 1 to generate an autonomous edge-synthesized intelligence brief.
                    </p>
                    <button @onclick='() => ScrollToScreen("screen-search")' class="mt-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition">
                        ← Back to Search (Screen 1)
                    </button>
                </div>
            }
        </div>
    </section>

    @* SCREEN 3: Data Matrix (Claims & Entities) *@
    <section id="screen-data" class="w-full h-full shrink-0 snap-center snap-always flex flex-col p-4 sm:p-8 pt-24 pb-20 relative overflow-y-auto hide-scrollbar">
        <div class="max-w-5xl mx-auto w-full space-y-8">
            @if (result != null)
            {
                @if (result.Claims.Any())
                {
                    <div>
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                            <span>🔍 Verified Claims Matrix</span>
                            <span class="px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 text-[10px]">@result.Claims.Count</span>
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            @foreach (var claim in result.Claims)
                            {
                                <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col justify-between space-y-3">
                                    <div>
                                        <div class="flex justify-between items-start mb-2 gap-2">
                                            <span class="px-2 py-0.5 rounded-full font-bold text-[10px] @GetEpistemicBadgeClass(claim.EpistemicStatus)">
                                                @claim.EpistemicStatus
                                            </span>
                                            <span class="text-xs font-bold text-slate-300 flex items-center gap-1">
                                                @claim.ConfidenceScore%
                                                <div class="w-8 bg-slate-800 h-1.5 rounded-full overflow-hidden ml-1">
                                                    <div class="bg-indigo-500 h-full" style="width: @(claim.ConfidenceScore)%"></div>
                                                </div>
                                            </span>
                                        </div>
                                        <p class="font-semibold text-slate-100 text-sm">@claim.Statement</p>
                                        <p class="font-mono text-[10px] text-slate-400 italic bg-slate-950/40 p-2 rounded mt-2 border border-slate-800">
                                            "@claim.VerbatimQuote"
                                        </p>
                                    </div>
                                    <div class="pt-2 border-t border-slate-800/60 flex justify-between items-center text-[10px]">
                                        <a href="@claim.SourceUrl" target="_blank" class="text-indigo-400 hover:underline truncate max-w-[200px]">@claim.SourceTitle</a>
                                        <button @onclick='() => RunPreset($"Deep research details on {claim.Statement}")' class="px-2 py-1 rounded bg-slate-800 hover:bg-indigo-600 text-slate-200 transition">
                                            Sub-Crawl
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (result.Entities.Any())
                {
                    <div class="pt-4 border-t border-slate-800/50">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                            <span>🌐 Entity Knowledge Graph</span>
                            <span class="px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 text-[10px]">@result.Entities.Count</span>
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                            @foreach (var entity in result.Entities)
                            {
                                <div class="p-3.5 rounded-xl bg-slate-900 border border-slate-800 flex flex-col justify-between">
                                    <div>
                                        <div class="flex items-center justify-between gap-2 mb-2">
                                            <h4 class="font-bold text-indigo-300 text-sm">@entity.Name</h4>
                                            <span class="px-2 py-0.5 rounded bg-slate-950 text-slate-400 text-[9px] font-semibold uppercase">@entity.Category</span>
                                        </div>
                                        <p class="text-[11px] text-slate-300 leading-relaxed">@entity.Description</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-10 text-center flex flex-col items-center justify-center space-y-4 my-auto">
                    <span class="text-5xl opacity-40">🌐</span>
                    <h3 class="text-xl font-bold text-white">Data Matrix Awaiting Telemetry</h3>
                    <p class="text-sm text-slate-400 max-w-md">
                        Claim verification matrices and knowledge graphs will materialize here once search execution completes.
                    </p>
                </div>
            }
        </div>
    </section>

    @* SCREEN 4: The /grill-me Stepper Deck *@
    <section id="screen-grill" class="w-full h-full shrink-0 snap-center snap-always flex flex-col p-4 sm:p-8 relative overflow-hidden bg-[var(--bg-darker)]">
        <div class="max-w-3xl mx-auto w-full h-full flex flex-col pt-16 sm:pt-0 justify-center">
            <div class="text-center mb-6 shrink-0">
                <span class="text-4xl mb-3 block animate-pulse">🎯</span>
                <h3 class="font-black text-2xl text-[var(--text-white)] tracking-tight">Interactive Decision Engine</h3>
                <p class="text-sm text-[var(--text-dark-muted)] mt-2">The AI paused at key research branches. Swipe through the deck and select your preferred paths for downstream evaluation.</p>
            </div>

            @if (result != null && result.GrillNodes != null && result.GrillNodes.Any())
            {
                var resolvedCount = result.GrillNodes.Count(n => n.IsResolved);
                var totalCount = result.GrillNodes.Count;
                var allResolved = resolvedCount == totalCount;
                var progressPct = (int)((float)resolvedCount / totalCount * 100);

                <div class="w-full mb-4 shrink-0 bg-[var(--bg-panel)] p-4 rounded-xl border border-[var(--border-dim)] flex items-center justify-between shadow-lg">
                    <div class="flex flex-col gap-1 w-full max-w-[200px]">
                        <span class="text-xs font-bold text-[var(--text-dark-muted)] uppercase tracking-wider">Decision Progress</span>
                        <div class="w-full h-2 bg-[rgba(255,255,255,0.05)] rounded-full overflow-hidden">
                            <div class="h-full bg-[var(--brand-accent)] transition-all duration-500 ease-out" style="width: @(progressPct)%"></div>
                        </div>
                    </div>
                    <span class="text-sm font-black font-mono @(allResolved ? "text-[var(--brand-accent)]" : "text-[var(--text-white)]")">
                        @resolvedCount / @totalCount
                    </span>
                </div>

                <div class="w-full flex-1 overflow-x-auto snap-x snap-mandatory flex gap-6 pb-8 hide-scrollbar scroll-smooth items-center">
                    @foreach (var node in result.GrillNodes)
                    {
                        <div id="node-@node.NodeId" class="w-[90%] sm:w-full max-w-2xl shrink-0 snap-center snap-always p-6 sm:p-8 rounded-2xl bg-[var(--bg-panel)] border @(node.IsResolved ? "border-[var(--brand-accent)] ring-1 ring-[var(--brand-accent)]" : "border-[rgba(240,136,62,0.3)]") shadow-2xl space-y-6 flex flex-col h-full max-h-[70vh] overflow-y-auto hide-scrollbar relative">
                            @if (node.IsResolved)
                            {
                                <div class="absolute inset-0 bg-[var(--brand-accent)]/5 rounded-2xl pointer-events-none"></div>
                            }
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-dim)] pb-4 shrink-0">
                                <span class="px-3 py-1.5 rounded-full text-[10px] font-black font-mono uppercase tracking-widest @(node.IsResolved ? "bg-[rgba(35,134,54,0.15)] text-[var(--brand-accent)]" : "bg-[rgba(240,136,62,0.15)] text-[#f0883e]")">
                                    Node #@node.StepIndex &bull; @(node.IsResolved ? "✓ Resolved" : "⏳ Awaiting Selection")
                                </span>
                                @if (!string.IsNullOrEmpty(node.SelectedOption))
                                {
                                    <span class="text-[10px] text-[var(--brand-accent)] font-bold bg-[rgba(35,134,54,0.1)] px-2 py-1 rounded border border-[rgba(35,134,54,0.2)] truncate max-w-[200px]">
                                        @node.SelectedOption
                                    </span>
                                }
                            </div>
                            
                            <div class="shrink-0">
                                <h4 class="font-black text-[var(--text-white)] text-xl sm:text-2xl tracking-tight mb-3 leading-tight">@node.Title</h4>
                                <p class="text-base text-[var(--text-white)] opacity-90 leading-relaxed font-medium">@node.ContextQuestion</p>
                            </div>

                            <div class="grid grid-cols-1 gap-3 mt-auto relative z-10">
                                @foreach (var opt in node.Options)
                                {
                                    var isCurrentSelected = node.SelectedOption == opt.Text;
                                    <div @onclick='() => SelectGrillOption(node, opt)'
                                         class="group touch-target p-4 rounded-xl border transition-all duration-200 cursor-pointer select-none @(isCurrentSelected ? "bg-[rgba(35,134,54,0.1)] border-[var(--brand-accent)] text-[var(--text-white)] shadow-md" : opt.IsRecommended ? "bg-[rgba(240,136,62,0.05)] border-[rgba(240,136,62,0.3)] hover:border-[#f0883e]" : "bg-[rgba(22,27,34,0.5)] border-[var(--border-dim)] hover:border-[rgba(139,148,158,0.5)]") flex flex-col gap-2">
                                        
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="flex items-center gap-2">
                                                @if (opt.IsRecommended)
                                                {
                                                    <span class="px-1.5 py-0.5 rounded bg-[rgba(240,136,62,0.2)] text-[#f0883e] font-black text-[9px] uppercase shadow-sm shrink-0" title="AI Recommended Option">★</span>
                                                }
                                                <span class="font-bold text-[15px] @(isCurrentSelected ? "text-[var(--brand-accent)]" : "text-[var(--text-white)]") group-hover:text-white transition-colors">@opt.Text</span>
                                            </div>
                                            <div class="shrink-0 pt-0.5">
                                                <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors @(isCurrentSelected ? "border-[var(--brand-accent)] bg-[var(--brand-accent)]" : "border-[var(--border-dim)] group-hover:border-[var(--text-dark-muted)]")">
                                                    @if (isCurrentSelected) { <span class="text-white text-[10px] font-black">✓</span> }
                                                </div>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(opt.Rationale))
                                        {
                                            <p class="text-xs text-[var(--text-dark-muted)] leading-relaxed pl-1 border-l-2 border-[var(--border-dim)] ml-1 @(isCurrentSelected ? "border-[var(--brand-accent)] opacity-100" : "opacity-80 group-hover:opacity-100")">
                                                @opt.Rationale
                                            </p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="shrink-0 flex justify-center mt-4">
                    @if (isLoading)
                    {
                        <div class="w-full sm:w-auto touch-target text-white font-black px-10 py-4 rounded-full shadow-2xl flex items-center justify-center gap-3 text-lg border bg-[var(--brand-accent)] border-[var(--brand-accent)]">
                            <span class="animate-spin text-xl">🔄</span>
                            <span>Executing Edge Hop...</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-[var(--text-dark-muted)] text-sm font-semibold">
                            @if (!allResolved)
                            {
                                <span>Resolve @(totalCount - resolvedCount) more nodes to continue.</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-16 bg-[var(--bg-panel)] border border-[var(--border-dim)] rounded-2xl p-8 shadow-lg max-w-lg mx-auto">
                    <span class="text-4xl mb-4 block opacity-60 animate-bounce">🧭</span>
                    <h4 class="font-bold text-[var(--text-white)] text-xl">No Active Decision Nodes</h4>
                    <p class="text-sm text-[var(--text-dark-muted)] mt-2 leading-relaxed">
                        Run a query in 🧠 <strong>Deep Multi-Hop Mode</strong> on Screen 1 to generate an interactive decision deck.
                    </p>
                    <button @onclick='() => ScrollToScreen("screen-search")' class="mt-4 px-6 py-2.5 rounded-full bg-[var(--brand-accent)] hover:bg-[var(--brand-accent-hover)] text-white font-bold text-xs transition">
                        Go to Search (Screen 1)
                    </button>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private string searchQuery = "";
    private string selectedMode = "deep_reasoning";
    private bool deepCrawl = true;
    private bool isLoading = false;
    private bool showPaymentAlert = false;
    private bool rateLimitHit = false;
    private string activeTab = "synthesis";
    private string? errorMessage = null;
    private SearchResultResponse? result = null;
    private UserStatus? userStatus = null;

    private async Task ScrollToScreen(string screenId)
    {
        await JS.InvokeVoidAsync("zlaInterop.scrollToElement", screenId);
    }

    private string UsagePillClass => userStatus?.SearchesRemaining switch
    {
        0     => "bg-red-500/20 border border-red-500/40 text-red-300",
        1     => "bg-amber-500/20 border border-amber-500/40 text-amber-300",
        2     => "bg-amber-500/15 border border-amber-500/30 text-amber-400",
        _     => "bg-slate-800 border border-slate-700 text-slate-400"
    };

    private string TimeUntilMidnightUtc
    {
        get
        {
            var now = DateTime.UtcNow;
            var midnight = now.Date.AddDays(1);
            var diff = midnight - now;
            return diff.Hours > 0 ? $"{diff.Hours}h {diff.Minutes}m" : $"{diff.Minutes}m";
        }
    }

    private string GetEpistemicBadgeClass(string status) => status switch
    {
        "Fact" => "bg-emerald-500/20 text-emerald-300 border border-emerald-500/40",
        "Disputed" => "bg-red-500/20 text-red-300 border border-red-500/40",
        "Marketing" => "bg-amber-500/20 text-amber-300 border border-amber-500/40",
        _ => "bg-indigo-500/20 text-indigo-300 border border-indigo-500/40"
    };

    private async Task EnsureJwtAttached()
    {
        var jwt = await JS.InvokeAsync<string>("zlaInterop.getJwtToken");
        if (!string.IsNullOrEmpty(jwt))
        {
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", jwt);
        }
        else
        {
            Http.DefaultRequestHeaders.Authorization = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        if (uri.Query.Contains("payment=success"))
            showPaymentAlert = true;

        try
        {
            await JS.InvokeAsync<string>("zlaInterop.checkPersonalizationSession");
        }
        catch { }

        await RefreshUserStatus();
    }

    private async Task RefreshUserStatus()
    {
        try
        {
            await EnsureJwtAttached();
            var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            userStatus = await Http.GetFromJsonAsync<UserStatus>("/api/user/status", jsonOpts);
            rateLimitHit = false;
        }
        catch {
            rateLimitHit = false;
        }
    }

    private string mainTab = "search";
    private string evalTargetUrl = "";
    private string evalResult = "";
    private string evalError = "";
    private bool isEvaluating = false;

    private async Task RunUrlEvaluation()
    {
        if (string.IsNullOrWhiteSpace(evalTargetUrl))
        {
            evalError = "Please enter a valid target URL.";
            return;
        }

        isEvaluating = true;
        evalError = "";
        evalResult = "";

        try
        {
            await EnsureJwtAttached();
            var response = await Http.PostAsJsonAsync("/api/eval", new { targetUrl = evalTargetUrl });
            if (response.IsSuccessStatusCode)
            {
                var data = await response.Content.ReadFromJsonAsync<EvalResponse>();
                evalResult = data?.Evaluation ?? "Evaluation complete.";
            }
            else
            {
                evalError = $"Evaluation failed: HTTP {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            evalError = $"Network error: {ex.Message}";
        }
        finally
        {
            isEvaluating = false;
        }
    }

    private async Task RunPreset(string query)
    {
        searchQuery = query;
        await PerformSearch();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading && !rateLimitHit)
            await PerformSearch();
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery) || rateLimitHit) return;

        isLoading = true;
        errorMessage = null;
        result = null;

        try
        {
            await EnsureJwtAttached();
            var req = new { query = searchQuery, deepCrawl, mode = selectedMode };
            var response = await Http.PostAsJsonAsync("/api/search", req);

            if (response.IsSuccessStatusCode)
            {
                var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                result = await response.Content.ReadFromJsonAsync<SearchResultResponse>(jsonOpts);
                activeTab = "synthesis";
                await IncrementCreditTickerState(credits: 2, estimatedTokens: 1200);
                await RefreshUserStatus();
                await ScrollToScreen("screen-synthesis");
            }
            else if ((int)response.StatusCode == 429)
            {
                rateLimitHit = true;
                errorMessage = "Daily free search limit reached (100/100). Upgrade to Pro for unlimited searches.";
                await RefreshUserStatus();
            }
            else
            {
                var bodyText = await response.Content.ReadAsStringAsync();
                errorMessage = $"Search engine encountered an issue ({response.StatusCode}). Quota was not deducted. Details: {bodyText}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Search failed: {ex.Message}. Quota was not deducted.";
            Console.WriteLine($"Search error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectGrillOption(InteractiveGrillNode node, GrillOption opt)
    {
        node.SelectedOption = opt.Text;
        node.IsResolved = true;
        
        var allResolved = result?.GrillNodes?.All(n => n.IsResolved) ?? false;
        if (allResolved)
        {
            await ExecuteGrillDownstreamHop();
        }
        else
        {
            var nextNode = result?.GrillNodes?.FirstOrDefault(n => !n.IsResolved);
            if (nextNode != null)
            {
                await JS.InvokeVoidAsync("zlaInterop.scrollToElement", "node-" + nextNode.NodeId);
            }
        }
    }

    private async Task ExecuteGrillDownstreamHop()
    {
        if (result == null || result.GrillNodes == null) return;
        var selected = result.GrillNodes
            .Where(n => n.IsResolved && !string.IsNullOrEmpty(n.SelectedOption))
            .Select(n => new { question = n.ContextQuestion, answer = n.SelectedOption })
            .ToList();

        if (!selected.Any()) return;

        isLoading = true;
        errorMessage = null;

        try
        {
            var payload = new
            {
                query = searchQuery,
                deepCrawl = deepCrawl,
                mode = selectedMode,
                selectedAnswers = selected
            };

            var response = await Http.PostAsJsonAsync("/api/search", payload);
            if (response.IsSuccessStatusCode)
            {
                var jsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                result = await response.Content.ReadFromJsonAsync<SearchResultResponse>(jsonOpts);
                activeTab = "synthesis";
                await IncrementCreditTickerState(credits: 1, estimatedTokens: 800);
                await RefreshUserStatus();
                await ScrollToScreen("screen-synthesis");
            }
            else
            {
                var bodyText = await response.Content.ReadAsStringAsync();
                errorMessage = $"Downstream hop failed ({response.StatusCode}): {bodyText}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Downstream hop exception: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task IncrementCreditTickerState(int credits, int estimatedTokens)
    {
        try
        {
            var raw = await JS.InvokeAsync<string>("zlaInterop.getCreditTickerState");
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var state = System.Text.Json.JsonSerializer.Deserialize<InspectaLlamaDO.Models.CreditTickerState>(raw, opts) ?? new InspectaLlamaDO.Models.CreditTickerState();
            state.CreditsUsed += credits;
            state.TokensProcessed += estimatedTokens;
            var json = System.Text.Json.JsonSerializer.Serialize(state);
            await JS.InvokeVoidAsync("zlaInterop.saveCreditTickerState", json);
        }
        catch { }
    }

    private bool isSyncing = false;
    private string syncStatusMessage = "";

    private async Task GeneratePdfReport()
    {
        if (result == null) return;
        var opts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
        var json = System.Text.Json.JsonSerializer.Serialize(result, opts);
        await JS.InvokeVoidAsync("zlaInterop.generateExecutivePdf", json);
    }

    private async Task ExportAsMarkdown()
    {
        if (result == null) return;
        var md = $"# InspectaLlama AI Report: {result.Query}\n\n" +
                 $"**Timestamp:** {result.Timestamp}\n\n" +
                 $"## Edge AI Synthesis\n\n{result.Synthesis}\n\n" +
                 $"## Inspected Sources\n\n";
        foreach (var s in result.Sources)
        {
            md += $"- [{s.Title}]({s.Url}) - {s.Snippet}\n";
        }

        var fileName = $"inspectallama_{DateTime.UtcNow:yyyyMMdd_HHmmss}.md";
        await JS.InvokeVoidAsync("zlaInterop.downloadFile", fileName, md, "text/markdown;charset=utf-8");
    }
}
