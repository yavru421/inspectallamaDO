@page "/"
@layout Layout.AppLayout
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ResearchStateService PipelineState

<PageTitle>InspectaLlama &bull; Command Center (Step 1)</PageTitle>

<div class="glass-card" style="max-width: 780px; margin: 2rem auto; padding: 2.5rem; border-color: var(--border-indigo); text-align: center;">
    <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1rem;">
        <span class="badge-tag badge-zla">STEP 1 OF 4</span>
        <span style="font-size: 0.75rem; font-family: 'JetBrains Mono', monospace; color: var(--accent-indigo);">&bull; Cloudflare Workers AI Edge Router</span>
    </div>

    <h1 style="font-family: 'Outfit', sans-serif; font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 900; color: #fff; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 1rem;">
        Interactive <span class="gradient-title">Grill-Me AI Studio</span>
    </h1>

    <p style="color: var(--text-muted); font-size: 1rem; max-width: 580px; margin: 0 auto 2rem; line-height: 1.6;">
        Input any topic to generate a domain-tailored interview decision tree, resolve design constraints step-by-step, and receive an executive AI report.
    </p>

    <div style="background: rgba(0,0,0,0.4); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <input @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleKeyUp"
                   placeholder="Enter any topic (e.g., 'alternating paddle stairs' or 'tactical weather radar')..."
                   class="grillme-input-custom" style="flex: 1; min-width: 280px; font-size: 1rem;" />
            <button @onclick="StartPipeline" disabled="@(string.IsNullOrWhiteSpace(searchQuery))"
                    class="btn-primary-custom" style="padding: 0.85rem 1.75rem; font-weight: 800; font-size: 1rem; white-space: nowrap;">
                Initiate Grill-Me &rarr;
            </button>
        </div>
    </div>

    <!-- Topic Presets -->
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.6rem; font-size: 0.85rem; color: var(--text-dim);">
        <span>Try Presets:</span>
        <button @onclick='() => RunPreset("Alternating paddle stairs building code & space geometry")' style="background: none; border: none; color: var(--accent-cyan); text-decoration: underline; cursor: pointer; font-weight: 600;">🪜 Alternating Paddle Stairs</button> &bull;
        <button @onclick='() => RunPreset("Cloudflare Workers AI Llama 3.3 70B Edge Architecture")' style="background: none; border: none; color: var(--accent-indigo); text-decoration: underline; cursor: pointer; font-weight: 600;">⚡ Workers AI Edge</button> &bull;
        <button @onclick='() => RunPreset("Tactical Weather Intercept Doppler Radar Setup")' style="background: none; border: none; color: var(--accent-emerald); text-decoration: underline; cursor: pointer; font-weight: 600;">🌪️ Radar Telemetry</button>
    </div>
</div>

<!-- Multi-Page Flow Navigator Cards -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; max-width: 900px; margin: 0 auto 3rem;">
    <a href="/grill" class="glass-card" style="padding: 1.25rem; text-decoration: none; color: var(--text-main);">
        <div style="font-size: 1.2rem; margin-bottom: 0.4rem;">🎯 Step 2</div>
        <div style="font-weight: 800; color: var(--accent-cyan);">Grill-Me Interview</div>
        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.3rem;">Resolve domain-tailored decision branches step-by-step.</div>
    </a>
    <a href="/research" class="glass-card" style="padding: 1.25rem; text-decoration: none; color: var(--text-main);">
        <div style="font-size: 1.2rem; margin-bottom: 0.4rem;">📄 Step 3</div>
        <div style="font-weight: 800; color: var(--accent-indigo);">Executive Report</div>
        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.3rem;">View synthesized specification & claim matrix.</div>
    </a>
    <a href="/telemetry" class="glass-card" style="padding: 1.25rem; text-decoration: none; color: var(--text-main);">
        <div style="font-size: 1.2rem; margin-bottom: 0.4rem;">📊 Step 4</div>
        <div style="font-weight: 800; color: var(--accent-emerald);">Edge Telemetry</div>
        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.3rem;">Audit WASM memory & edge router latency.</div>
    </a>
</div>

@code {
    private string searchQuery = "";

    protected override void OnInitialized()
    {
        PipelineState.CurrentStageIndex = 1;
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
            StartPipeline();
    }

    private void RunPreset(string query)
    {
        searchQuery = query;
        StartPipeline();
    }

    private void StartPipeline()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        PipelineState.StartNewPipeline(searchQuery);
        NavManager.NavigateTo("grill");
    }
}


