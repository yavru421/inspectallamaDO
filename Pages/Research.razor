@page "/research"

<PageTitle>InspectaLlama - Deep Research Engine</PageTitle>

<div style="margin-bottom: 2rem;">
    <h1 class="gradient-title" style="font-size: 2.2rem; font-weight: 800;">Deep Research Engine</h1>
    <p style="color: var(--text-muted); margin-top: 0.25rem;">Multi-Track Intelligence & Bare-Metal Vector Queries</p>
</div>

<div class="glass-card" style="margin-bottom: 2rem;">
    <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
        <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Search research vectors, keywords, or tags..." 
               style="flex: 1; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); padding: 0.75rem 1rem; border-radius: var(--radius-sm); color: #fff; font-size: 0.95rem; outline: none;" />
        <button class="btn-primary-custom" @onclick="AddResearchCard">New Vector (+)</button>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
    @foreach (var item in FilteredItems)
    {
        <div class="glass-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
                <span class="badge-tag" style="background: rgba(99, 102, 241, 0.15); color: var(--accent-indigo); border: 1px solid rgba(99, 102, 241, 0.3);">@item.Category</span>
                <span style="font-size: 0.75rem; color: var(--text-dim);">@item.Timestamp</span>
            </div>
            <h3 style="font-size: 1.15rem; color: var(--text-main); margin-bottom: 0.5rem;">@item.Title</h3>
            <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem;">@item.Snippet</p>
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
                <span style="font-size: 0.78rem; color: var(--accent-cyan);">Status: @item.Status</span>
                <button style="background: none; border: none; color: var(--accent-rose); font-size: 0.8rem; cursor: pointer;" @onclick="() => RemoveItem(item)">Remove</button>
            </div>
        </div>
    }
</div>

@code {
    private string searchQuery = "";

    private class ResearchItem
    {
        public string Title { get; set; } = "";
        public string Category { get; set; } = "";
        public string Snippet { get; set; } = "";
        public string Timestamp { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private List<ResearchItem> items = new List<ResearchItem>();

    protected override void OnInitialized()
    {
        items = new List<ResearchItem>
        {
            new ResearchItem { Title = "Local WASM DuckDB Benchmarks", Category = "Compute", Snippet = "Analyzing browser in-memory SQL performance with zero backend latency.", Timestamp = "Today, 20:40", Status = "Verified" },
            new ResearchItem { Title = "Cloudflare Durable Objects Cache-Busting", Category = "Edge", Snippet = "Strict no-store headers and sliding timestamp heartbeats for mobile clients.", Timestamp = "Today, 19:15", Status = "Active" },
            new ResearchItem { Title = "Zero-Liability Architecture Patterns", Category = "Architecture", Snippet = "Building client-side applications with zero ongoing server maintenance.", Timestamp = "Yesterday", Status = "Complete" }
        };
    }

    private IEnumerable<ResearchItem> FilteredItems =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? items
            : items.Where(i => i.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                               i.Snippet.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                               i.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private void AddResearchCard()
    {
        items.Insert(0, new ResearchItem
        {
            Title = $"Custom Research Track #{items.Count + 1}",
            Category = "User R&D",
            Snippet = "Dynamic research vector synthesized directly in client Blazor WASM state.",
            Timestamp = "Just now",
            Status = "In Progress"
        });
    }

    private void RemoveItem(ResearchItem item)
    {
        items.Remove(item);
    }
}
