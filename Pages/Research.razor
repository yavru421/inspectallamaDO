@page "/research"
@inject HttpClient Http
@inject ResearchStateService State
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>InspectaLlama &bull; Synthesized Research Report (Step 4)</PageTitle>

<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
    <div>
        <span class="badge-tag badge-zla" style="margin-bottom: 0.5rem;">PIPELINE STEP 4 OF 5</span>
        <h1 class="gradient-title" style="font-size: 2rem; font-weight: 800;">Synthesized Research Report</h1>
        <p style="color: var(--text-muted); margin-top: 0.25rem;">Publication-grade AI synthesis for: <strong style="color: var(--accent-cyan);">@State.ActiveTopic</strong></p>
    </div>

    @if (State.FinalResult != null)
    {
        <div style="display: flex; gap: 0.5rem;">
            <button class="btn-secondary-custom" style="padding: 0.5rem 0.9rem; font-size: 0.82rem;" @onclick="ExportMarkdown">
                📄 Export Markdown
            </button>
            <button class="btn-primary-custom" style="padding: 0.5rem 0.9rem; font-size: 0.82rem;" @onclick="GeneratePdfReport">
                ⚡ Print Executive PDF
            </button>
        </div>
    }
</div>

@if (State.FinalResult != null)
{
    <!-- Report Output -->
    <div class="glass-card" style="margin-bottom: 2rem; border-color: var(--border-cyan);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
            <span class="badge-tag badge-zla">DIALECTICAL SYNTHESIS COMPLETE</span>
            <span style="font-size: 0.8rem; color: var(--text-dim);">@State.FinalResult.Timestamp</span>
        </div>

        <div style="font-size: 1.02rem; line-height: 1.8; color: var(--text-main); white-space: pre-wrap; margin-bottom: 1.5rem;">
            @State.FinalResult.Synthesis
        </div>

        @if (State.FinalResult.Claims != null && State.FinalResult.Claims.Count > 0)
        {
            <h3 style="font-size: 1.1rem; color: var(--accent-indigo); margin-bottom: 0.85rem; font-family: 'Outfit', sans-serif;">
                Verified Claims Matrix (@State.FinalResult.Claims.Count)
            </h3>
            <div style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 1.5rem;">
                @foreach (var claim in State.FinalResult.Claims)
                {
                    <div style="background: rgba(0,0,0,0.35); border-left: 3px solid var(--accent-indigo); padding: 0.85rem 1.1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.3rem;">
                            <div style="font-weight: 700; color: var(--text-main);">@claim.Statement</div>
                            <span class="badge-tag" style="background: rgba(16,185,129,0.15); color: var(--accent-emerald); border: 1px solid var(--border-emerald); font-size: 0.72rem;">@claim.EpistemicStatus (@claim.ConfidenceScore%)</span>
                        </div>
                        <div style="font-size: 0.82rem; color: var(--text-muted);">
                            Verbatim Quote: "<em>@claim.VerbatimQuote</em>" &bull; 
                            <a href="@claim.SourceUrl" target="_blank" style="color: var(--accent-cyan); font-weight: 600;">@claim.SourceTitle</a>
                        </div>
                    </div>
                }
            </div>
        }

        @if (State.FinalResult.Sources != null && State.FinalResult.Sources.Count > 0)
        {
            <h3 style="font-size: 1.1rem; color: var(--accent-cyan); margin-bottom: 0.85rem; font-family: 'Outfit', sans-serif;">
                Audited Edge Citations (@State.FinalResult.Sources.Count)
            </h3>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem;">
                @foreach (var src in State.FinalResult.Sources)
                {
                    <div style="font-size: 0.85rem; color: var(--text-muted); background: rgba(0,0,0,0.2); padding: 0.6rem 0.85rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                        <a href="@src.Url" target="_blank" style="color: var(--accent-cyan); font-weight: 700; text-decoration: none;">@src.Title</a> &bull;
                        <span style="color: var(--text-dim);">@src.Snippet</span>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="glass-card" style="text-align: center; padding: 3rem;">
        <h3 style="color: var(--text-main); margin-bottom: 0.5rem;">Research Synthesis Pending</h3>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">No synthesis generated yet for topic: "@State.ActiveTopic"</p>
        <button class="btn-primary-custom" @onclick='() => Nav.NavigateTo("grill")'>← Go to Grill-Me Interrogation (Step 2)</button>
    </div>
}

<div style="display: flex; justify-content: space-between; align-items: center;">
    <button class="btn-secondary-custom" @onclick='() => Nav.NavigateTo("grill")'>
        &larr; Back to Grill-Me Interview (Step 2)
    </button>

    <button class="btn-primary-custom" @onclick='() => Nav.NavigateTo("telemetry")'>
        View Edge Telemetry (Step 4) &rarr;
    </button>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        State.CurrentStageIndex = 3;
        if (string.IsNullOrWhiteSpace(State.ActiveTopic))
        {
            State.ActiveTopic = "Zero-Liability Architecture Blazor Edge Patterns";
        }

        if (State.FinalResult != null)
        {
            try
            {
                var opts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
                var json = System.Text.Json.JsonSerializer.Serialize(State.FinalResult, opts);
                await JS.InvokeVoidAsync("zlaInterop.saveIndexedDbResult", State.ActiveTopic, json);
            }
            catch { }
        }
    }

    private async Task GeneratePdfReport()
    {
        if (State.FinalResult == null) return;
        var opts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
        var json = System.Text.Json.JsonSerializer.Serialize(State.FinalResult, opts);
        await JS.InvokeVoidAsync("zlaInterop.generateExecutivePdf", json);
    }

    private async Task ExportMarkdown()
    {
        if (State.FinalResult == null) return;
        var md = $"# InspectaLlama AI Report: {State.FinalResult.Query}\n\n" +
                 $"**Timestamp:** {State.FinalResult.Timestamp}\n\n" +
                 $"## Dialectical Edge Synthesis\n\n{State.FinalResult.Synthesis}\n\n" +
                 $"## Inspected Sources\n\n";
        foreach (var s in State.FinalResult.Sources)
        {
            md += $"- [{s.Title}]({s.Url}) - {s.Snippet}\n";
        }

        var fileName = $"inspectallama_{DateTime.UtcNow:yyyyMMdd_HHmmss}.md";
        await JS.InvokeVoidAsync("zlaInterop.downloadFile", fileName, md, "text/markdown;charset=utf-8");
    }
}
